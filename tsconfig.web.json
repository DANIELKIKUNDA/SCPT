{
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./out/web-types",
    "rootDir": ".",
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/renderer/src/**/*.css",
    "src/remotion/**/*.ts",
    "src/remotion/**/*.tsx",
    "src/shared/types/**/*.ts",
    "tsconfig.web.json"
  ]
}
